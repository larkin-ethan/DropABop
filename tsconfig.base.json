{
  // Shared compiler settings. Each workspace has its own tsconfig.json that extends this one.
  // TypeScript only type-checks here (noEmit): Vite builds the frontend and esbuild (via SAM)
  // bundles the Lambdas, so there is no separate compile step to keep in sync.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    // Array/record lookups may be undefined: forces handling "not found" cases explicitly.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
