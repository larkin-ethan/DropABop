{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright test*)",
      "Bash(bash scripts/guardrails.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(sam validate*)",
      "Bash(sam build*)",
      "Bash(docker compose *)"
    ],
    "ask": [
      "Bash(aws *)",
      "Bash(sam deploy*)",
      "Bash(sam sync*)",
      "Bash(sam local *)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Edit(docs/SPEC.md)",
      "Edit(scripts/guardrails.sh)",
      "Edit(scripts/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(docs/decisions/approved-aws-resources.txt)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(~/.aws/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/guardrails.sh\" >/dev/null",
            "timeout": 30,
            "statusMessage": "Checking guardrails"
          }
        ]
      }
    ]
  }
}
